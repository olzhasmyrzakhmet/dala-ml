{
  "name": "dala-ml",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:mobile": "playwright test --project=\"Mobile Chrome\"",
    "e2e:offline": "playwright test -c playwright.dist.config.ts",
    "serve:dist": "node scripts/serve-dist.mjs",
    "shots": "playwright test --project=\"Mobile Chrome\" e2e/shots.spec.ts",
    "icons": "node scripts/make-icons.mjs",
    "prod:verify": "node scripts/prod-verify.mjs",
    "e2e:perf": "playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5",
    "vitest": "^1.6.0",
    "@playwright/test": "^1.44.0"
  }
}
